# Application
APPLICATION_NAME=Your_application_name
APPLICATION_PORT=Your_application_port
APPLICATION_HOST=Your_application_host

# Admin auto generate
ADMIN_EMAIL=Default_admin_email
ADMIN_PASSWORD=Default_admin_password
ADMIN_FIRST_NAME=Default_admin_first_name
ADMIN_LAST_NAME=Default_admin_last_name

# Store auto generate
STORE_NAME=Default_store_name
STORE_DESCRIPTION=Default_store_description
STORE_LOCATION=Default_store_location
STORE_SUPPORT_EMAIL=Default_store_support_email
STORE_SUPPORT_PHONE_NUMBER=Default_store_support_phone_number
STORE_IS_ACTIVE=true

# Database connection
DB_HOST=Your_database_host
DB_PORT=Your_database_port
DB_DATASOURCE=Your_database_name
DB_USERNAME=Your_database_username
DB_PW=Your_database_password

# Jwt
SECRET_KEY=Your_scret_key
ACCESS_TOKEN_EXP=900000
REFRESH_TOKEN_EXP=604800000

# Cookie security (true only behind HTTPS)
COOKIE_SECURE=true

# Swagger UI / OpenAPI (disable in production)
SWAGGER_ENABLED=false

# File storage for uploaded images, and the log file
FILE_PATH=./file-storage
LOG_FILE=./file-storage/logs/backend.log

# Image upload limits (optional, defaults shown)
MAX_UPLOAD_SIZE=10MB
MAX_UPLOAD_REQUEST_SIZE=11MB

# CORS URLS
CORS_URLS=Your_frontend_site(e.g.http://localhost:3000,http://localhost:3001)


# Redis cache for store info (docker-compose.yaml starts it on 127.0.0.1:6379)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=Your_redis_password

# Google sign-in (Google Cloud Console > APIs & Services > Credentials > OAuth client ID, type "Web application").
# Same client id as GOOGLE_CLIENT_ID in Frontend/Customer-Facing; leave empty to turn Google sign-in off.
GOOGLE_CLIENT_ID=

# Email (SMTP) for one-time codes. Leave MAIL_HOST empty to turn email verification off.
# e.g. Gmail: smtp.gmail.com / 587 / your address / an App Password (not your normal password)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=Your_smtp_username
MAIL_PASSWORD=Your_smtp_password
MAIL_FROM=Your_store_name <no-reply@example.com>
